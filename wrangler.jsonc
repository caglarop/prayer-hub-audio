{
  // Cloudflare Workers with static assets: serves this repository (landing page, privacy page,
  // Quran recitation) at salah-hub.net. No build step, no code — assets only.
  "name": "salah-hub",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
